APP_ENV=local
APP_DEBUG=true

# Auditoría silenciosa (admin_audit_log). Recomendado activar en producción.
AUDIT_ENABLED=false

# Métricas de login (éxitos/fallos)
AUTH_METRICS_ENABLED=true

# Retención de eventos de login (días). Usar con tools/cleanup-auth-login-events.php
# Recomendación: éxitos 365d, fallos 180d, logout 90d
AUTH_LOGIN_RETENTION_SUCCESS_DAYS=365
AUTH_LOGIN_RETENTION_FAILED_DAYS=180
AUTH_LOGIN_RETENTION_LOGOUT_DAYS=90

# Versiones legales (se guardan al registrarse)
TERMS_VERSION=11/04/2026
PRIVACY_VERSION=11/04/2026

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mitiendapesca
DB_USER=user
DB_PASS=secret

# Mercado Pago
MP_PUBLIC_KEY=TEST-XXXXXXXXXXXXXXX
MP_ACCESS_TOKEN=TEST-REEMPLAZAR_POR_TOKEN_DE_PRUEBA
MP_WEBHOOK_SECRET=
MP_SANDBOX=1

# Transferencia bancaria (checkout)
BANK_NAME=Banco de prueba
BANK_ALIAS=MI.TIENDA.PESCA
BANK_CBU=0000000000000000000000
BANK_OWNER=Mi Tienda Pesca
BANK_CUIT=00-00000000-0

# Email (Mailer)
MAIL_FROM_EMAIL=no-reply@mitiendapesca.com
MAIL_FROM_NAME=Mi Tienda Pesca

# Email Marketing (Etapa 2)
EMAIL_MARKETING_SCHEDULER_LIMIT=200
EMAIL_MARKETING_WORKER_LIMIT=25
EMAIL_MARKETING_WELCOME_BACKFILL_DAYS=14
EMAIL_MARKETING_CART_ABANDONED_MAX_DAYS=14
EMAIL_MARKETING_POSTPURCHASE_MAX_DAYS=30

# Timezone de la app (evita desfase horario en campañas/checkout/etc.)
APP_TIMEZONE=America/Argentina/Buenos_Aires

# YouTube Data API v3
YOUTUBE_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_FEATURED_VIDEO_ID=
YOUTUBE_PLAYLIST_ID_PEJERREY=
YOUTUBE_CACHE_TTL_CHANNEL=3600
YOUTUBE_CACHE_TTL_VIDEOS=900

# Sesión
# Tiempo máximo de inactividad antes de pedir re-login (minutos)
SESSION_IDLE_MINUTES=120


# ------------------------------------------------------------
# Correo Argentino (MiCorreo / PAQ.AR)
# NOTA: No incluyas credenciales reales en el repo. Pegalas en tu .env local.
# Modo: prod | test (homologación)
CORREO_MODE=prod
# Base URL (si se deja vacío, el sistema elige según CORREO_MODE)
# CORREO_API_BASE_URL=https://apitest.correoargentino.com.ar/micorreo/v1
# CORREO_API_BASE_URL=https://api.correoargentino.com.ar/micorreo/v1
CORREO_API_BASE_URL=

# Credenciales
CORREO_API_USERNAME=
CORREO_API_PASSWORD=
CORREO_USER_EMAIL=
CORREO_USER_PASSWORD=

# Token opcional para endpoints internos (ej: cron de tracking)
CORREO_TRACKING_CRON_TOKEN=
