# Seguridad básica
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # No reescribir archivos/carpetas existentes (assets, uploads, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Front controller
  RewriteRule ^ index.php [L]
</IfModule>

# Bloquear archivos sensibles
<FilesMatch "(^\.env|composer\.(json|lock)|phpunit\.xml|\.git|\.htaccess)$">
  Require all denied
</FilesMatch>
